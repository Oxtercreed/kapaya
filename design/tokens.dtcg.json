{
  "$description": "KAPAYA \u2014 monochrome editorial. Values are the ones shipping in src/styles/mono.css.",
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#fbfaf7",
      "$description": "page ground"
    },
    "paper-2": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "paper-3": {
      "$type": "color",
      "$value": "#f1f0eb",
      "$description": "plate ground / hover"
    },
    "ink": {
      "$type": "color",
      "$value": "#0b0b0a",
      "$description": "text, solid buttons, footer"
    },
    "ink-2": {
      "$type": "color",
      "$value": "#24241f"
    },
    "ink-soft": {
      "$type": "color",
      "$value": "#5b5b52",
      "$description": "secondary copy, captions"
    },
    "ink-faint": {
      "$type": "color",
      "$value": "#97978d",
      "$description": "folios, meta"
    },
    "line": {
      "$type": "color",
      "$value": "rgba(11,11,10,0.13)",
      "$description": "hairline"
    },
    "line-strong": {
      "$type": "color",
      "$value": "rgba(11,11,10,0.45)",
      "$description": "underline, control border"
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Bodoni Moda",
        "Didot",
        "Times New Roman",
        "serif"
      ]
    },
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Instrument Sans",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    }
  },
  "type": {
    "masthead": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "106px",
        "fontWeight": 400,
        "lineHeight": 0.86,
        "letterSpacing": "-0.045em"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "62px",
        "fontWeight": 400,
        "lineHeight": 0.98,
        "letterSpacing": "-0.03em"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "44px",
        "fontWeight": 400,
        "lineHeight": 1.02,
        "letterSpacing": "-0.028em"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "24px",
        "fontWeight": 400,
        "lineHeight": 1.14,
        "letterSpacing": "-0.018em"
      }
    },
    "product-name": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": "18.5px",
        "fontWeight": 400,
        "lineHeight": 1.1,
        "letterSpacing": "-0.01em"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "15px",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": "-0.004em"
      }
    },
    "lede": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "16.5px",
        "fontWeight": 400,
        "lineHeight": 1.66,
        "letterSpacing": "0"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "10px",
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "0.2em",
        "textCase": "upper"
      }
    },
    "folio": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "9px",
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "0.16em",
        "textCase": "upper"
      }
    },
    "money": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "10.5px",
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": "0.08em",
        "textCase": "upper"
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "10.5px",
        "fontWeight": 600,
        "lineHeight": 1,
        "letterSpacing": "0.18em",
        "textCase": "upper"
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "24px"
    },
    "6": {
      "$type": "dimension",
      "$value": "32px"
    },
    "7": {
      "$type": "dimension",
      "$value": "48px"
    },
    "8": {
      "$type": "dimension",
      "$value": "64px"
    },
    "9": {
      "$type": "dimension",
      "$value": "104px"
    },
    "gutter-mobile": {
      "$type": "dimension",
      "$value": "18px"
    },
    "gutter-desktop": {
      "$type": "dimension",
      "$value": "56px"
    },
    "max-width": {
      "$type": "dimension",
      "$value": "1560px"
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "The system is square. Anything else is a mistake.",
    "all": {
      "$value": "0px"
    }
  },
  "border": {
    "hairline": {
      "$type": "border",
      "$value": {
        "color": "{color.line}",
        "width": "1px",
        "style": "solid"
      }
    },
    "rule-ink": {
      "$type": "border",
      "$value": {
        "color": "{color.ink}",
        "width": "1px",
        "style": "solid"
      }
    },
    "control": {
      "$type": "border",
      "$value": {
        "color": "{color.line-strong}",
        "width": "1px",
        "style": "solid"
      }
    }
  },
  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": {
        "color": "transparent",
        "offsetX": "0",
        "offsetY": "0",
        "blur": "0",
        "spread": "0"
      }
    },
    "overlay": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(11,11,10,0.45)",
        "offsetX": "0",
        "offsetY": "40",
        "blur": "80",
        "spread": "-60"
      }
    }
  }
}